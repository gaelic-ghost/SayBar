{
  "manifest_version": 3,
  "name": "SayBar Page Speaker",
  "description": "Capture readable website text and hand it to SayBar.",
  "version": "0.1.0",
  "action": {
    "default_title": "Speak Page with SayBar",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:7339/*"
  ],
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting"
  ]
}
